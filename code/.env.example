# Local settings for `npm run dev` and the test suite. Copy to code/.env (gitignored) and fill in the local values.
# Variable names only here; never commit values (AGENTS.md 10).

# 32 random bytes, base64, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
TOTP_ENCRYPTION_KEY=

# Staff mail over SMTP. Local: Mailpit on 127.0.0.1:1025, no authentication (UI http://127.0.0.1:8025).
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FixTriage <no-reply@fixtriage.localhost>
# Mailpit API used by the integration tests only.
MAILPIT_API=http://127.0.0.1:8025/api/v1

# Object storage over the S3 API. Local: MinIO on 127.0.0.1:9000, bucket fixtriage-dev (already created).
STORAGE=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=fixtriage-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Own load balancer or proxy addresses, comma-separated (empty locally: the TCP peer is the client).
TRUSTED_PROXIES=
