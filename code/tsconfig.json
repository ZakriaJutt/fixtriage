{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/*/src/**/*.ts", "apps/*/test/**/*.ts", "apps/web/app/**/*.ts", "apps/web/instrumentation.ts", "packages/*/src/**/*.ts", "packages/*/scripts/**/*.ts", "packages/*/test/**/*.ts", "packages/db/drizzle.config.ts", "tools/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "**/.next/**"]
}
