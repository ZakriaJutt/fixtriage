{
  "name": "fixtriage",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "tools/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "db:setup": "tsx packages/db/scripts/setup-role.ts",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:reset-test": "tsx packages/db/scripts/reset-test.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "check:migrations": "tsx packages/db/scripts/check-migrations.ts",
    "seed:synthetic": "tsx packages/db/scripts/seed-synthetic.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run db:reset-test && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
